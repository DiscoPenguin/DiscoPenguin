{
    "version":"0.2.0",
    "configurations": [
        {
            "name": "Launch API",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/StarWarsTcgApi/StarWarsTcgApi.Api/StarWarsTcgApi.Api.csproj"
        },
        {
            "name": "Launch Angular",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/StarWarsTcg.Web",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "start"
            ],
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bCompiled successfully\\b",
                "uriFormat": "http://localhost:4200"
            },
            "outFiles": [
                // "${workspaceFolder}/Web/dist/**/*.js"
                ""
            ]
        }
    ],
    "compounds": [
        {
            "name": "Compound",
            "configurations": ["Launch API", "Launch Angular"]
        }
    ]
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387

}